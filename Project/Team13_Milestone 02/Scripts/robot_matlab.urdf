<?xml version="1.0" encoding="utf-8"?>
<!-- Plain URDF expanded from the official my_robot_gazebo/urdf/robot.urdf.xacro (CMS, 22 Sep 2026)
     for smimport in Simscape Multibody. Geometry, joints and inertias are copied unchanged;
     only xacro args are replaced by their defaults (base at world origin, base_link_lift = 0.0438),
     Gazebo plugin blocks are dropped, and mesh paths point to ./meshes. -->
<robot name="robot_matlab">
  <link name="world"/>
  <joint name="world_to_base_footprint" type="fixed">
    <parent link="world"/><child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_footprint"/>
  <joint name="base_footprint_to_Base_Link" type="fixed">
    <parent link="base_footprint"/><child link="Base_Link"/>
    <origin xyz="0 0 0.0438" rpy="0 0 0"/>
  </joint>

  <link name="Base_Link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.8"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/Base_Link.STL"/></geometry>
      <material name="mat_base_red"><color rgba="1 0 0 1"/></material></visual>
  </link>

  <link name="Rotating_Waste">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.7"/>
      <inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0015"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/Rotating_Waste.STL"/></geometry>
      <material name="mat_steel"><color rgba="0.75294 0.75294 0.75294 1"/></material></visual>
  </link>

  <joint name="Joint_1" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="Base_Link"/><child link="Rotating_Waste"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="200" velocity="2.0"/>
  </joint>

  <link name="Arm_1">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.6"/>
      <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0012"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/Arm_1.STL"/></geometry>
      <material name="mat_white"><color rgba="1 1 1 1"/></material></visual>
  </link>

  <joint name="Joint_2" type="revolute">
    <origin xyz="-2.7567E-05 0.0061999 0.04975" rpy="1.5708 0 0"/>
    <parent link="Rotating_Waste"/><child link="Arm_1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="200" velocity="2.0"/>
  </joint>

  <link name="Arm_2">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.5"/>
      <inertia ixx="0.0009" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0009"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/Arm_2.STL"/></geometry>
      <material name="mat_steel"><color rgba="0.75294 0.75294 0.75294 1"/></material></visual>
  </link>

  <joint name="Joint_3" type="revolute">
    <origin xyz="0 0.140 0.000" rpy="0 0 1.5708"/>
    <parent link="Arm_1"/><child link="Arm_2"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-3.14159" upper="3.14159" effort="200" velocity="2.0"/>
  </joint>

  <link name="Arm_3">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.4"/>
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0006"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/Arm_3.STL"/></geometry>
      <material name="mat_steel"><color rgba="0.75294 0.75294 0.75294 1"/></material></visual>
  </link>

  <joint name="Arm_3_lock" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    <parent link="Arm_2"/><child link="Arm_3"/>
  </joint>

  <link name="Gripper">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.3"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0003"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/Gripper.STL"/></geometry>
      <material name="mat_base_red"><color rgba="1 0 0 1"/></material></visual>
  </link>

  <joint name="Joint_4" type="revolute">
    <origin xyz="-0.001651 -0.0054574 0.13289" rpy="1.5708 0 0"/>
    <parent link="Arm_3"/><child link="Gripper"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="200" velocity="2.0"/>
  </joint>

  <link name="EE_frame">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.005"/></geometry>
      <material name="mat_green"><color rgba="0 1 0 1"/></material></visual>
  </link>

  <joint name="EE_frame_lock" type="fixed">
    <parent link="Gripper"/><child link="EE_frame"/>
    <origin xyz="0.007 0.1 0.013" rpy="0 0 0"/>
  </joint>
</robot>
